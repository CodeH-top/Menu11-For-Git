<Page
    x:Class="Menu11.App.Views.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Padding="28,22,28,32"
            HorizontalAlignment="Stretch">
            <TextBlock x:Uid="GeneralPageTitle" Style="{StaticResource PageTitleStyle}" />

            <TextBlock x:Uid="GeneralSectionMenu11" Style="{StaticResource SectionTitleStyle}" />
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource SettingTileStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="EnableMenuLabel"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            Grid.Column="1"
                            x:Uid="EnableMenuToggle"
                            Style="{StaticResource CompactToggleSwitchStyle}"
                            IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SettingTileStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="CommandIconsLabel"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            Grid.Column="1"
                            x:Uid="CommandIconsToggle"
                            Style="{StaticResource CompactToggleSwitchStyle}"
                            IsOn="{x:Bind ViewModel.ShowIcons, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource SettingTileStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="GitBashLabel"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            Grid.Column="1"
                            x:Uid="GitBashToggle"
                            Style="{StaticResource CompactToggleSwitchStyle}"
                            IsOn="{x:Bind ViewModel.ShowGitBash, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingTileStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="GitGuiLabel"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            Grid.Column="1"
                            x:Uid="GitGuiToggle"
                            Style="{StaticResource CompactToggleSwitchStyle}"
                            IsOn="{x:Bind ViewModel.ShowGitGui, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource SettingTileStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="SettingsMenuLabel"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                        <ToggleSwitch
                            Grid.Column="1"
                            x:Uid="SettingsMenuToggle"
                            Style="{StaticResource CompactToggleSwitchStyle}"
                            IsOn="{x:Bind ViewModel.ShowSettingsCommand, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingTileStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="LanguageLabel"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="LanguageBox"
                            Grid.Column="1"
                            MinWidth="142"
                            VerticalAlignment="Center"
                            SelectionChanged="LanguageBox_SelectionChanged">
                            <ComboBoxItem x:Uid="LanguageSystemOption" Tag="system" />
                            <ComboBoxItem x:Uid="LanguageEnglishOption" Tag="en-US" />
                            <ComboBoxItem x:Uid="LanguageChineseOption" Tag="zh-CN" />
                        </ComboBox>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock x:Uid="ExplorerSection" Style="{StaticResource SectionTitleStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Click="RefreshExplorer_Click" Style="{StaticResource IconTextButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Viewbox Style="{StaticResource ButtonIconViewboxStyle}">
                            <SymbolIcon Symbol="Refresh" />
                        </Viewbox>
                        <TextBlock x:Uid="RefreshExplorerButtonLabel" Style="{StaticResource ButtonLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Click="RestoreDefaults_Click" Style="{StaticResource IconTextButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Viewbox Style="{StaticResource ButtonIconViewboxStyle}">
                            <SymbolIcon Symbol="Undo" />
                        </Viewbox>
                        <TextBlock x:Uid="RestoreDefaultsButtonLabel" Style="{StaticResource ButtonLabelStyle}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <InfoBar
                x:Name="ResultBar"
                Margin="0,10,0,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Success" />
        </StackPanel>
    </ScrollViewer>
</Page>
