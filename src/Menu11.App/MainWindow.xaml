<Window
    x:Class="Menu11.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Menu11 for Git">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <NavigationView
            x:Name="Navigation"
            x:Uid="Navigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="True"
            ItemInvoked="Navigation_ItemInvoked"
            CompactPaneLength="38"
            OpenPaneLength="200"
            PaneDisplayMode="Left">
            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewIconBoxWidth">32</x:Double>
                <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">16</x:Double>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">32</x:Double>
                <x:Double x:Key="NavigationViewPaneHeaderRowMinHeight">36</x:Double>
                <Thickness x:Key="NavigationViewItemButtonMargin">4,1</Thickness>
                <Thickness x:Key="NavigationViewItemContentPresenterMargin">0,-1,6,-1</Thickness>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavGeneral" Tag="general" Style="{StaticResource CompactNavigationItemStyle}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavGitMenu" Tag="git-menu" Style="{StaticResource CompactNavigationItemStyle}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavGitForWindows" Tag="git-for-windows" Style="{StaticResource CompactNavigationItemStyle}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavAbout" Tag="about" Style="{StaticResource CompactNavigationItemStyle}">
                    <NavigationViewItem.Icon>
                        <PathIcon Width="15" Height="15">
                            <PathIcon.Data>
                                <PathGeometry FillRule="EvenOdd">
                                    <PathGeometry.Transform>
                                        <ScaleTransform ScaleX="0.625" ScaleY="0.625" />
                                    </PathGeometry.Transform>
                                    <PathFigure StartPoint="12,1" IsClosed="True">
                                        <ArcSegment Point="12,23" Size="11,11" SweepDirection="Clockwise" />
                                        <ArcSegment Point="12,1" Size="11,11" SweepDirection="Clockwise" />
                                    </PathFigure>
                                    <PathFigure StartPoint="12,3" IsClosed="True">
                                        <ArcSegment Point="12,21" Size="9,9" SweepDirection="Clockwise" />
                                        <ArcSegment Point="12,3" Size="9,9" SweepDirection="Clockwise" />
                                    </PathFigure>
                                    <PathFigure StartPoint="11,14.75" IsClosed="True">
                                        <LineSegment Point="13,14.75" />
                                        <BezierSegment Point1="13,13.8" Point2="13.32,13.43" Point3="14.12,12.78" />
                                        <BezierSegment Point1="15.23,11.88" Point2="16,10.92" Point3="16,9.35" />
                                        <BezierSegment Point1="16,7.08" Point2="14.28,5.5" Point3="12,5.5" />
                                        <BezierSegment Point1="9.87,5.5" Point2="8.25,6.67" Point3="7.53,8.58" />
                                        <LineSegment Point="9.42,9.29" />
                                        <BezierSegment Point1="9.84,8.16" Point2="10.68,7.5" Point3="11.95,7.5" />
                                        <BezierSegment Point1="13.2,7.5" Point2="14,8.21" Point3="14,9.35" />
                                        <BezierSegment Point1="14,10.16" Point2="13.56,10.69" Point3="12.79,11.31" />
                                        <BezierSegment Point1="11.73,12.17" Point2="11,13.08" Point3="11,14.75" />
                                    </PathFigure>
                                    <PathFigure StartPoint="12,17" IsClosed="True">
                                        <ArcSegment Point="12,19.5" Size="1.25,1.25" SweepDirection="Clockwise" />
                                        <ArcSegment Point="12,17" Size="1.25,1.25" SweepDirection="Clockwise" />
                                    </PathFigure>
                                </PathGeometry>
                            </PathIcon.Data>
                        </PathIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
        <InfoBar
            x:Name="RegistrationResultBar"
            Grid.Row="1"
            Margin="12,0,12,10"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />
    </Grid>
</Window>
